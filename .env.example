# Vergex environment template.
# `make init` copies this file to .env and fills the three keys below with
# fresh random values; existing values in .env are never overwritten.

# ===========================================
# Network (docker compose)
# ===========================================

# Address and port the web UI listens on. The API is served under /api/ by the
# same port. Keep 127.0.0.1 and put a TLS reverse proxy in front for remote
# access (see docs/deployment.md).
VERGEX_BIND_ADDRESS=127.0.0.1
VERGEX_FRONTEND_PORT=8000

# Backend port, only used when the backend port mapping is enabled in
# docker-compose.yml for direct debugging.
VERGEX_BACKEND_PORT=3000

# Container timezone
TZ=Asia/Shanghai

# ===========================================
# Keys (required, generated by `make init`)
# ===========================================

# JWT signing secret: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-this-in-production

# AES-256 key for API keys and secrets stored in the database: openssl rand -base64 32
# Changing it makes stored credentials unreadable.
DATA_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# RSA private key (PEM on one line, newlines written as \n) for optional
# browser-side encryption of API keys: openssl genrsa 2048
RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----

# Encrypt API keys in the browser before sending (requires HTTPS or localhost)
TRANSPORT_ENCRYPTION=false

# ===========================================
# Database
# ===========================================

# SQLite (default)
DB_TYPE=sqlite
DB_PATH=data/data.db

# PostgreSQL: set DB_TYPE=postgres and fill these instead
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=vergex
# DB_PASSWORD=
# DB_NAME=vergex
# DB_SSLMODE=disable
